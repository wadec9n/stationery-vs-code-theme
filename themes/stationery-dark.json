  "tokenColors": [
    {
      "scope": [
        "text.html.markdown",
        "text.html.markdown meta.paragraph",
        "meta.paragraph.markdown"
      ],
      "settings": {
        "foreground": "#F3EFE7"
      }
    },
    {
      "scope": [
        "meta.frontmatter",
        "meta.embedded.block.frontmatter"
      ],
      "settings": {
        "foreground": "#DFDAC8"
      }
    },
    {
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "meta.mapping.key.yaml",
        "punctuation.separator.key-value.yaml"
      ],
      "settings": {
        "foreground": "#D5B080"
      }
    },
    {
      "scope": [
        "string.unquoted.yaml",
        "string.quoted.yaml",
        "meta.mapping.value.yaml"
      ],
      "settings": {
        "foreground": "#A8D2B0"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#D5B080"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#A8D2B0"
      }
    },
    {
      "scope": [
        "punctuation.support.type.property-name.json",
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.definition.string.begin.json",
        "punctuation.definition.string.end.json"
      ],
      "settings": {
        "foreground": "#B5B5A8"
      }
    },
    {
      "scope": [
        "constant.language.json",
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#E2A595"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A19682",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ADA28E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#CC7A52"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#959890"
      }
    },
    {
      "scope": [
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#CC7A52"
      }
    },
    {
      "scope": [
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#B5B5A8"
      }
    },
    {
      "scope": [
        "support.class.component",
        "entity.name.tag.localname.astro",
        "entity.name.tag.localname.jsx",
        "entity.name.tag.localname.tsx",
        "meta.jsx.children entity.name.tag",
        "meta.tag.custom.start entity.name.tag",
