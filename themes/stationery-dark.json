  "tokenColors": [
    {
      "scope": [
        "text.html.markdown",
        "text.html.markdown meta.paragraph",
        "meta.paragraph.markdown"
      ],
      "settings": {
        "foreground": "#F2EDE3"
      }
    },
    {
      "scope": [
        "meta.frontmatter",
        "meta.embedded.block.frontmatter"
      ],
      "settings": {
        "foreground": "#E0E8EC"
      }
    },
    {
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "meta.mapping.key.yaml",
        "punctuation.separator.key-value.yaml"
      ],
      "settings": {
        "foreground": "#E8B15F"
      }
    },
    {
      "scope": [
        "string.unquoted.yaml",
        "string.quoted.yaml",
        "meta.mapping.value.yaml"
      ],
      "settings": {
        "foreground": "#8CCAA0"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#E8B15F"
      }
    },
    {
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json",
        "meta.structure.array.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#8CCAA0"
      }
    },
    {
      "scope": [
        "punctuation.support.type.property-name.json",
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.definition.string.begin.json",
        "punctuation.definition.string.end.json"
      ],
      "settings": {
        "foreground": "#AAB6BD"
      }
    },
    {
      "scope": [
        "constant.language.json",
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#D9907C"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7C919C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8BA0AA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#F0A05E"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9AA8B1"
      }
    },
    {
      "scope": [
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#F0A05E"
      }
    },
    {
      "scope": [
        "punctuation.accessor",
        "punctuation.separator.key-value",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#AAB6BD"
      }
    },
    {
      "scope": [
        "support.class.component",
        "entity.name.tag.localname.astro",
        "entity.name.tag.localname.jsx",
        "entity.name.tag.localname.tsx",
        "meta.jsx.children entity.name.tag",
        "meta.tag.custom.start entity.name.tag",
        "meta.tag.custom.end entity.name.tag"
      ],
      "settings": {
        "foreground": "#FFD08A"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag entity.name.tag"
      ],
      "settings": {
        "foreground": "#63CBEA"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.astro",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "meta.tag.attributes entity.other.attribute-name",
        "support.type.property-name.css",
        "meta.property-list.css meta.property-name",
        "entity.other.attribute-name.class.css"
