# Example environment file.
# Showcases dotenv grammar: comments, plain values, quoted strings,
# escapes, multi-line values, and ${VAR} interpolation.

# --- Service ----------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_NAME=stationery-api

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://user:pass@example.com:5432/stationery
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
JWT_SECRET="a long secret with spaces and a # hash inside"
JWT_AUDIENCE='https://api.example.com'
JWT_TTL_SECONDS=3600

# --- Feature flags ----------------------------------------------------------
ENABLE_TLS=true
ENABLE_TRACING=false
ENABLE_PREVIEW=1

# --- Interpolation and escapes ---------------------------------------------
PUBLIC_URL=https://${HOST}:${PORT}
LOG_PREFIX="[${APP_NAME}]"
ESCAPED_VALUE="line one\nline two\t\"quoted\""

# --- Multi-line --------------------------------------------------------------
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ
-----END PRIVATE KEY-----"

# Empty values and trailing comments are valid too.
OPTIONAL_FLAG=                # left intentionally blank
DEBUG=stationery:*            # comma- or colon-separated globs
